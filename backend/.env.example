# Backend runtime settings.
ENVIRONMENT=development
LOG_LEVEL=INFO
DOCS_ENABLED=true
API_PORT=8000

# Local MongoDB without authentication (default developer setup).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=environmental_intelligence

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Docker Compose credentials.
# For Docker Compose, copy this file to the repository root as `.env` and set
# strong, URL-safe values. The API container receives an authenticated
# MONGODB_URI constructed from these values. Never commit real secrets.
MONGO_ROOT_USERNAME=environment_admin
MONGO_ROOT_PASSWORD=replace-with-a-strong-url-safe-password
